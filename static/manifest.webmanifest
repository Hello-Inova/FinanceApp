  "categories": ["finance", "productivity"],
  "icons": [
    {
      "src": "/static/img/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Finanças", "short_name": "Finanças", "url": "/home", "icons": [{ "src": "/static/img/pwa-icon-192.png", "sizes": "192x192" }] },
    { "name": "Metas", "short_name": "Metas", "url": "/metas", "icons": [{ "src": "/static/img/pwa-icon-192.png", "sizes": "192x192" }] },
    { "name": "Agenda", "short_name": "Agenda", "url": "/agenda", "icons": [{ "src": "/static/img/pwa-icon-192.png", "sizes": "192x192" }] }
  ]
}
