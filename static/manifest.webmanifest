{
  "id": "/",
  "name": "FinanceApp",
  "short_name": "FinanceApp",
  "description": "Controle suas finanças, metas, compromissos e compras em um só lugar.",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020617",
